# Copy to .env.blog on VPS and set real values
# Preferred: OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# Alternative: direct OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# Set to 1 only if you want automatic draft publishing when OpenAI is unavailable
ALLOW_FALLBACK_DRAFT=0
